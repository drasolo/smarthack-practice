# Copy to .env (gitignored). Emdash copies .env into every worktree.

# Where real data lives, outside the repo. Default: ~/smarthack-data
DATA_DIR=

# LLM for the product, not for the coding agents. LLM_PROVIDER is one of:
#   claude     Claude on your own Claude plan, through the Claude Code CLI. No API key: sign in
#              once with `claude auth login`. Each of us uses our own login; never share one.
#   anthropic  an API key in ANTHROPIC_API_KEY.
#   (empty)    the offline templates in api/explain.py. Tests always use these.
# Handing the project off: the new owner sets LLM_PROVIDER=anthropic with their own key, or
# signs in to Claude Code with their own account. No code changes either way.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Only on a machine where nobody can sign in (a server): a token from `claude setup-token`.
# It's personal, like a password.
# CLAUDE_CODE_OAUTH_TOKEN=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_LANGUAGE=ro

# Serve contract/mocks instead of computed results (UI work before ml/ is ready).
USE_MOCKS=
