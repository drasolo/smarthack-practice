# Copy to .env (gitignored). Emdash copies .env into every worktree.

# Where real data lives, outside the repo. Default: ~/smarthack-data
DATA_DIR=

# LLM for the product (not for the coding agents). "fake" needs no key and is the default
# when ANTHROPIC_API_KEY is empty.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_LANGUAGE=ro

# Serve contract/mocks instead of computed results (UI work before ml/ is ready).
USE_MOCKS=
